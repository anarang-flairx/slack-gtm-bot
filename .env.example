SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Set to true to test Slack without OpenAI
DEV_ECHO_MODE=true

# Required when DEV_ECHO_MODE is not true
#OPENAI_API_KEY=sk-your-openai-key
# Optional: model for the mention agent (default gpt-4.1)
#OPENAI_MODEL=gpt-4.1
# Optional: cheaper model for short confirmations like "yes" (default gpt-4.1-mini)
#OPENAI_CHEAP_MODEL=gpt-4.1-mini
# Optional: vision model for badge/business-card/screenshot OCR (default gpt-4o)
#OPENAI_VISION_MODEL=gpt-4o

# HubSpot Service Key
HUBSPOT_ACCESS_TOKEN=pat-na1-your-service-key
# Sales deal pipeline id (HubSpot often uses "default" for Sales).
HUBSPOT_PIPELINE_ID=default
# Partnerships deal pipeline id — required for correct Partnership stages.
HUBSPOT_PARTNERSHIP_PIPELINE_ID=2487098051
# Internal name of the company relationship-type property (Partnerships only).
HUBSPOT_RELATIONSHIP_TYPE_PROPERTY=relationship_type
HUBSPOT_METHOD_OF_CONTACT_PROPERTY=method_of_contact
# Domains never archived by "cleanup" (comma-separated). Defaults to GMAIL_SENDER_EMAIL domain or flairx.ai.
#INTERNAL_EMAIL_DOMAINS=flairx.ai
HUBSPOT_PORTAL_ID=242879565
HUBSPOT_APP_HOST=app-na2.hubspot.com

# Custom notes / activity date properties (internal names).
# The *_NOTES_PROPERTY must be a writable text property.
# The *_ACTIVITY_DATE_PROPERTY can be either:
#   - a HubSpot built-in like `notes_last_updated` (read-only): the bot reads it
#     but skips writing it, so its own text-notes won't bump the date, OR
#   - a WRITABLE custom Date property you create (Settings > Properties): the
#     bot stamps it whenever it appends a note.
HUBSPOT_CONTACT_NOTES_PROPERTY=outreach_notes
HUBSPOT_CONTACT_ACTIVITY_DATE_PROPERTY=last_contact_date
HUBSPOT_COMPANY_NOTES_PROPERTY=company_notes
HUBSPOT_COMPANY_ACTIVITY_DATE_PROPERTY=notes_last_updated
HUBSPOT_DEAL_NOTES_PROPERTY=deal_notes
HUBSPOT_DEAL_ACTIVITY_DATE_PROPERTY=notes_last_updated

# Gmail (compose drafts + read-only inbox; run: npm run gmail-auth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=ceo@flairx.com
SENDER_NAME=Abhilasha Juneja

# Resource links for intro-draft template (optional)
GMAIL_AI_REPORT_URL=https://example.com/ai-interview-report
GMAIL_EXPERT_REPORT_URL=https://example.com/expert-interview-report
GMAIL_COMPARISON_REPORT_URL=https://example.com/candidate-comparison-report

# Auto-log sent emails to HubSpot notes (polls Gmail; writes automatically).
# Opt-in: set to true to enable. Requires Gmail auth (npm run gmail-auth).
EMAIL_LOG_ENABLED=false
# How often to poll for newly sent mail (minutes).
EMAIL_LOG_POLL_MINUTES=5
# How far back each poll looks for sent mail (days).
EMAIL_LOG_LOOKBACK_DAYS=1
# Slack channel for the "logged email" FYI posts (falls back to DIGEST_CHANNEL).
#EMAIL_LOG_CHANNEL=C0123456789
# Where dedup state is stored (so the same email isn't logged twice).
#EMAIL_LOG_STATE_PATH=.data/email-log-state.json

# Daily digest (/digest)
DIGEST_CHANNEL=C0123456789
STALL_DAYS_LATE_STAGE=7
STALL_DAYS_EARLY_STAGE=14
FOLLOWUP_DAYS_ATTEMPTED=4
FOLLOWUP_DAYS_CONNECTED=7
DIGEST_MAX_ROWS=8
# Max open deals to analyze for follow-up (reads email chains + notes).
#DIGEST_MAX_SCAN=40

# Daily marketing cleanup (8am local by default). Posts Approve/Discard to CLEANUP_CHANNEL or DIGEST_CHANNEL.
# Also reviews blank-name companies (+ their contacts) from the lookback window — one card each.
# Nothing is archived without an Approve click; Never Log is updated on approve.
# Set CLEANUP_ENABLED=false to disable. Manual "@bot cleanup" still works (same 24h window).
#CLEANUP_ENABLED=true
#CLEANUP_CHANNEL=C0123456789
#CLEANUP_HOUR=8
#CLEANUP_TZ=America/Los_Angeles
#CLEANUP_LOOKBACK_HOURS=24
#CLEANUP_STATE_PATH=data/cleanup-schedule-state.json
# Emails/domains the email auto-logger will never write notes for (updated when a cleanup card is approved).
#NEVER_LOG_PATH=data/never-log.json

# Missing-email reminders: when a contact/company/deal is created with no email
# address, auto-create a HubSpot task + Slack nudge to go get one.
#MISSING_EMAIL_REMINDER=true
#MISSING_EMAIL_REMINDER_HOURS=24
